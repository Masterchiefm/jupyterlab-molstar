{
  "name": "jupyterlab-molstar",
  "version": "0.1.0",
  "description": "Open PDB, mmCIF, MMTF and other molecular structure files directly in the JupyterLab file browser and view them with Mol*",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension",
    "molstar",
    "pdb",
    "cif",
    "protein-structure",
    "molecular-viewer"
  ],
  "homepage": "https://github.com/Masterchiefm/jupyterlab-molstar",
  "bugs": {
    "url": "https://github.com/Masterchiefm/jupyterlab-molstar/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "jupyterlab-molstar contributors"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.{js,d.ts,js.map}",
    "labextension/**/*"
  ],
  "scripts": {
    "build": "jlpm run build:lib && jlpm run build:labextension",
    "build:lib": "tsc --build",
    "build:labextension": "jupyter labextension build --minimize True . && node scripts/copy-vendor.js",
    "clean": "jlpm run clean:lib && jlpm run clean:labextension",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "clean:labextension": "rimraf labextension"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.5.0",
    "@jupyterlab/apputils": "^4.5.0",
    "@jupyterlab/coreutils": "^6.5.0",
    "@jupyterlab/docregistry": "^4.5.0",
    "@jupyterlab/ui-components": "^4.5.0",
    "@lumino/coreutils": "^2.0.0",
    "@lumino/messaging": "^2.0.0",
    "@lumino/widgets": "^2.5.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.5.0",
    "molstar": "^5.13.0",
    "rimraf": "^5.0.0",
    "typescript": "~5.5.4"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "labextension",
    "disabledExtensions": []
  }
}
